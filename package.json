  "exports": {
    ".": "./host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "memory-entries.mjs",
    "memory-scan.mjs",
    "memory-store.mjs",
    "memory-prompt.mjs",
    "memory-review.mjs",
    "memory-brief.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
